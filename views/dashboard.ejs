<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: sans-serif; background: #f4f7f6; margin: 0; padding-bottom: 80px; }
        .h { background: #0066cc; color: white; padding: 15px; text-align: center; position: sticky; top: 0; display: flex; justify-content: center; align-items: center; }
        .logout-btn { position: absolute; left: 15px; background: rgba(255,255,255,0.2); border: 1px solid white; color: white; padding: 6px; border-radius: 4px; font-size: 0.7rem; }
        .container { padding: 12px; max-width: 600px; margin: auto; }
        .card { background: white; margin-bottom: 15px; padding: 18px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-top: 5px solid #0066cc; }
        .btn { display: block; color: white; text-align: center; padding: 15px; border-radius: 8px; font-weight: bold; border: none; width: 100%; margin-top: 10px; cursor: pointer; background: #0066cc; text-decoration: none; }
        .fab { position: fixed; bottom: 20px; right: 20px; background: #27ae60; color: white; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; text-decoration: none; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    </style>
</head>
<body>
    <div class="h">
        <button class="logout-btn" onclick="localStorage.clear(); location.href='/';">LOGOUT</button>
        <h2 style="margin:0; font-size: 1.1rem;">Space TV Dashboard</h2>
    </div>
    <div class="container">
        <div id="greeting" style="font-weight:bold; color:#555; margin-bottom:15px;"></div>
        <div id="pendingList"></div>
    </div>
    <a href="/front-desk" class="fab">+</a>

    <script>
        const user = localStorage.getItem("username") || "Technician";
        document.getElementById('greeting').innerText = `Welcome, ${user}`;

        async function loadJobs() {
            const res = await fetch('/api/jobs');
            const data = await res.json();
            const list = document.getElementById('pendingList');
            list.innerHTML = data.pending.map(j => `
                <div class="card">
                    <h3>${j.customer}</h3>
                    <p><b>Loc:</b> ${j.loc}</p>
                    <p><b>Issue:</b> ${j.prob}</p>
                    <a href="/work-job?rowId=${j.rowId}&name=${encodeURIComponent(j.customer)}&tel=${j.tel}&loc=${encodeURIComponent(j.loc)}&prob=${encodeURIComponent(j.prob)}" class="btn">START WORK</a>
                </div>
            `).join('');
        }
        loadJobs();
    </script>
</body>
</html>
