<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: sans-serif; padding: 20px; background: #f9f9f9; }
        .box { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); max-width: 450px; margin: auto; }
        label { font-weight: bold; display: block; margin-top: 15px; }
        input, select, textarea { width: 100%; padding: 12px; margin-top: 5px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .sub { background: #0066cc; color: white; border: none; padding: 15px; width: 100%; margin-top: 25px; font-weight: bold; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="box">
        <h2 style="color:#0066cc; margin:0;"><%= query.name %></h2>
        <p><b>Tel:</b> <%= query.tel %></p>
        <form id="f">
            <label>Status</label>
            <select id="s"><option value="Done">Done</option><option value="Rescheduled">Rescheduled</option></select>
            <label>Remarks</label>
            <select id="r">
                <option value="Completed Successfully">Completed Successfully</option>
                <option value="Faulty decoder">Faulty decoder</option>
                <option value="Return Job">Return Job</option>
            </select>
            <label>Notes</label>
            <textarea id="n" rows="2"></textarea>
            <label>Amount (GHS)</label>
            <input type="number" id="a" value="0" step="0.01">
            <button type="submit" class="sub" id="btn">SUBMIT UPDATE</button>
        </form>
    </div>
    <script>
        document.getElementById('f').onsubmit = async (e) => {
            e.preventDefault();
            const data = {
                rowId: "<%= query.rowId %>", name: "<%= query.name %>", status: s.value,
                amount: a.value, remarks: r.value, notes: n.value,
                installer: localStorage.getItem('username') || "Tech"
            };
            localStorage.setItem('tempReceipt', JSON.stringify(data));
            await fetch('/submit-job', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data) });
            window.location.href = s.value === "Done" ? '/receipt-flip' : '/dashboard';
        };
    </script>
</body>
</html>
