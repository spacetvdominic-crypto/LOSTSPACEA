<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Front Desk - Space TV</title>
    <style>
        body { font-family: sans-serif; background: #f0f2f5; margin: 0; padding: 20px; }
        .form-container { background: white; padding: 25px; border-radius: 12px; max-width: 500px; margin: auto; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .h { text-align: center; color: #0066cc; margin-bottom: 20px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; color: #555; font-size: 0.8rem; }
        input, select { width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 1rem; }
        .sub-btn { width: 100%; padding: 15px; background: #27ae60; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 1.1rem; cursor: pointer; }
        
        /* NEW SECTION FOR VIEWING RECENT JOBS */
        .recent-jobs { max-width: 500px; margin: 30px auto; }
        .job-card { background: white; padding: 15px; border-radius: 8px; margin-bottom: 10px; border-left: 5px solid #0066cc; position: relative; font-size: 0.9rem; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .job-card h4 { margin: 0 0 5px 0; color: #333; }
        .job-card p { margin: 2px 0; color: #666; }
        .controls { margin-top: 10px; display: flex; gap: 10px; }
        .ctrl-btn { flex: 1; padding: 8px; border: none; border-radius: 4px; font-size: 0.75rem; font-weight: bold; cursor: pointer; }
        .resched { background: #f39c12; color: white; }
        .cancel { background: #e74c3c; color: white; }
    </style>
</head>
<body>

    <div class="form-container">
        <div class="h">
            <h2 style="margin:0;">Job Entry</h2>
        </div>

        <label>Customer Name</label>
        <input type="text" id="cust" placeholder="Full Name">
        <label>Tel No.</label>
        <input type="tel" id="tel" placeholder="024 XXX XXXX">
        <label>Location</label>
        <input type="text" id="loc" placeholder="Street / Area">
        <label>Technical Problem</label>
        <select id="prob">
            <option value="Full Installation">Full Installation</option>
            <option value="Signal Problem">Signal Problem</option>
            <option value="Dish Install">Dish Install</option>
            <option value="Relocation">Relocation</option>
            <option value="Xtraview setup">Xtraview setup</option>
            <option value="Full install w/ Xtraview">Full install w/ Xtraview</option>
            <option value="Antenna Installation">Antenna Installation</option>
            <option value="TV Installation">TV Installation</option>
            <option value="Dish Removal">Dish Removal</option>
        </select>
        <label>System Type</label>
        <select id="type">
            <option value="Dstv">Dstv</option>
            <option value="Gotv">Gotv</option>
            <option value="Dstv/Gotv">Both</option>
        </select>

        <button class="sub-btn" onclick="saveJob()" id="btn">SAVE JOB</button>
    </div>

    <!-- NEW RECENT JOBS FEED -->
    <div class="recent-jobs">
        <h3 style="color:#555;">Recent Entries</h3>
        <div id="jobList">Loading jobs...</div>
    </div>

    <script>
        async function saveJob() {
            const btn = document.getElementById('btn');
            const data = {
                customer: document.getElementById('cust').value,
                tel: document.getElementById('tel').value,
                loc: document.getElementById('loc').value,
                prob: document.getElementById('prob').value,
                type: document.getElementById('type').value
            };
            if(!data.customer || !data.tel) return alert("Fill Name and Tel!");
            
            btn.innerText = "SAVING..."; btn.disabled = true;
            const res = await fetch(`/api/add-job?customer=${encodeURIComponent(data.customer)}&tel=${data.tel}&loc=${encodeURIComponent(data.loc)}&prob=${encodeURIComponent(data.prob)}&type=${data.type}`);
            if(res.ok) { 
                alert("Job Saved!"); 
                location.reload(); 
            }
        }

        async function loadRecent() {
            const res = await fetch('/api/jobs');
            const data = await res.json();
            const list = document.getElementById('jobList');
            list.innerHTML = "";
            
            // Only show Pending or Rescheduled jobs for the Front Desk to manage
            data.pending.concat(data.rescheduled).forEach(j => {
                list.innerHTML += `
                    <div class="job-card">
                        <h4>${j.customer}</h4>
                        <p><strong>Loc:</strong> ${j.loc} | <strong>Tel:</strong> ${j.tel}</p>
                        <p><strong>Service:</strong> ${j.prob}</p>
                        <div class="controls">
                            <button class="ctrl-btn resched" onclick="updateJob('${j.rowId}', 'Rescheduled')">RESCHEDULE</button>
                            <button class="ctrl-btn cancel" onclick="updateJob('${j.rowId}', 'Cancel')">CANCEL JOB</button>
                        </div>
                    </div>`;
            });
        }

        async function updateJob(rowId, status) {
            if(!confirm(`Change job status to ${status}?`)) return;
            // Re-using the installer submit endpoint to update status
            await fetch('/submit-job', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ rowId: rowId, status: status, amount: 0, remarks: "Updated by Front Desk", installer: "Front Desk" })
            });
            loadRecent();
        }

        loadRecent();
    </script>
</body>
</html>
