<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { background:#555; display:flex; flex-direction:column; align-items:center; padding:20px; font-family:monospace; }
        .r { background:white; width:100%; max-width:350px; padding:25px; box-sizing: border-box; }
        .row { display:flex; justify-content:space-between; margin:10px 0; border-bottom:1px dashed #ddd; }
        .momo-box { background: #f0f7ff; border: 1px solid #0066cc; padding: 10px; margin: 20px 0; font-size: 0.8rem; text-align: center; }
        button { width: 100%; padding: 15px; margin-top: 10px; border-radius: 5px; border: none; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
    <div class="r" id="printArea">
        <h2 style="text-align:center; color:#0066cc; margin:0;">SPACE TV</h2>
        <p style="text-align:center; font-size:0.7rem;">0243 326 023 / 0544 913 868</p>
        <div class="row"><span>Date:</span><span id="d"></span></div>
        <div class="row"><span>Customer:</span><span id="n"></span></div>
        <div class="row"><span>Installer:</span><span id="s"></span></div>
        <p><strong>Service:</strong> <span id="rem"></span></p>
        <h2 style="text-align:center; border-top:2px solid #000; padding-top:10px;">GHS <span id="amt"></span></h2>
        <div class="momo-box"><strong>PAYMENT:</strong> Company MoMo 0243 326 023</div>
    </div>
    <button style="background:#333; color:white;" onclick="window.print()">PRINT / PDF</button>
    <button style="background:#0066cc; color:white;" onclick="location.href='/dashboard'">BACK</button>
    <script>
        const data = JSON.parse(localStorage.getItem('tempReceipt'));
        if(data) {
            d.innerText = new Date().toLocaleDateString();
            n.innerText = data.name;
            s.innerText = data.installer;
            rem.innerText = data.remarks;
            amt.innerText = parseFloat(data.amount).toFixed(2);
        }
    </script>
</body>
</html>
