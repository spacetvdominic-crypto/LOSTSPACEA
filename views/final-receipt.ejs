<!DOCTYPE html>
<html>
<head>
    <title>Space TV Receipt</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        .receipt { border: 2px solid #333; padding: 20px; max-width: 400px; margin: auto; }
        .h { text-align: center; border-bottom: 2px solid #eee; margin-bottom: 20px; }
        .row { display: flex; justify-content: space-between; margin: 10px 0; }
    </style>
</head>
<body>
    <div class="receipt">
        <div class="h">
            <h2>SPACE TV</h2>
            <p>Quality Signal Solutions</p>
        </div>
        <div class="row"><span>Customer:</span> <b><%= query.name %></b></div>
        <div class="row"><span>Service:</span> <b><%= query.prob %></b></div>
        <div class="row"><span>Note:</span> <b><%= query.rem %></b></div>
        <hr>
        <div class="row" style="font-size: 1.4rem;"><span>TOTAL:</span> <b>₵<%= query.amt %></b></div>
        <p style="text-align:center; margin-top:30px; font-size:0.8rem;">Thank you for choosing Space TV!</p>
        <button onclick="window.location.href='/dashboard'" style="width:100%; padding:10px; margin-top:10px;">Back to Jobs</button>
    </div>
</body>
</html>